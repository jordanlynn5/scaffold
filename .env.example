# Copy this file to .env.local and fill in the values.
# .env.local is never committed. These names are listed in
# devpost/spec.md > Where It Runs and How Someone Tries It.

# Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Claude (console.anthropic.com)
ANTHROPIC_API_KEY=
# Optional. Unset means claude-opus-5-5. Set to a cheaper model while developing.
PLAN_MODEL=

# Twilio WhatsApp Sandbox
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
TWILIO_SANDBOX_JOIN_CODE=

# Resend
RESEND_API_KEY=
EMAIL_FROM=

# A long random string. Supabase Cron sends it when it rings the 15-minute bell.
CRON_SECRET=

# Where the app lives, e.g. http://localhost:3000 or https://your-app.vercel.app
APP_URL=
